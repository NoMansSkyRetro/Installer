<Window x:Class="NMSRetroInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NMSRetroInstaller"
        Title="No Man's Sky Retro Installer" Icon="icon.ico"
        Width="1160" Height="600" Background="#262326"
        WindowStartupLocation="CenterScreen"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
        <!-- Every step is authored against the same 1050x520 board and scaled to fit. -->
        <Viewbox Stretch="Uniform" Margin="36,20">
            <Grid x:Name="Stage" Width="1050" Height="520">
                <local:IntroView x:Name="Intro"/>
                <local:VersionsView x:Name="Versions" Visibility="Collapsed"/>
                <local:InstallView x:Name="Install" Visibility="Collapsed"/>
                <local:CompleteView x:Name="Complete" Visibility="Collapsed"/>
            </Grid>
        </Viewbox>

        <!-- Outside the Viewbox so they dim the whole window, not just the board. -->
        <local:BusyOverlay x:Name="Busy"/>
        <local:SteamGuardOverlay x:Name="Guard"/>
    </Grid>
</Window>
