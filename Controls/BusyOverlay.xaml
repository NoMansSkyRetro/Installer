<UserControl x:Class="NMSRetroInstaller.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMSRetroInstaller"
             Opacity="0" Visibility="Collapsed">
    <Grid Background="#80000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <Grid Width="104" Height="104" HorizontalAlignment="Center">
                <Ellipse Margin="4" Stroke="#4E4A4E" StrokeThickness="5"/>
                <!-- A 110 degree arc of the same circle, spun by the code-behind. -->
                <Path Stroke="{StaticResource Accent}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 52,4 A 48,48 0 0 1 97.1,36.6">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="Spin" CenterX="52" CenterY="52"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <TextBlock x:Name="Status" Margin="0,26,0,0" FontSize="18"
                       HorizontalAlignment="Center" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
