<UserControl x:Class="NMSRetroInstaller.SteamGuardOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMSRetroInstaller"
             Opacity="0" Visibility="Collapsed">

    <!-- Dims the sign-in screen behind it and swallows anything aimed at it. -->
    <Grid Background="#99000000">
        <Border x:Name="Panel" Width="470" Opacity="0" Padding="24,20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}"
                BorderThickness="2" RenderTransformOrigin="0.5,0.5">
            <StackPanel>
                <TextBlock Text="STEAM GUARD" FontSize="24" Foreground="White"/>

                <TextBlock x:Name="Blurb" Margin="0,10,0,0" FontSize="12" LineHeight="16"
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>

                <TextBlock x:Name="Warning" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" Foreground="{StaticResource Accent}"
                           Text="That code was not accepted. Try the current one."/>

                <TextBlock Margin="0,16,0,0" Text="CODE" Style="{StaticResource FieldLabel}"/>
                <!-- Width="Auto" undoes the fixed width the Field style needs on the Canvas-laid
                     sign-in screen; here the box has to fit the panel, or its right edge is
                     clipped off along with that side of its border. -->
                <TextBox x:Name="CodeBox" Margin="0,4,0,0" Height="34" MaxLength="10"
                         Width="Auto" HorizontalAlignment="Stretch"
                         CharacterCasing="Upper" Style="{StaticResource Field}"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <local:AccentButton Text="CANCEL" Click="OnCancel"
                                        Width="140" Height="38" FontSize="16"/>
                    <local:AccentButton Grid.Column="1" Text="CONTINUE" Click="OnContinue"
                                        Margin="10,0,0,0" Height="38" FontSize="16"
                                        HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
