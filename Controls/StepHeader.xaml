<UserControl x:Class="NMSRetroInstaller.StepHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMSRetroInstaller">
    <Canvas Width="1050" Height="98">
        <Image Canvas.Left="24" Canvas.Top="14" Width="41" Height="70">
            <Image.Source>
                <!-- Just the diamond out of the full logo artwork. -->
                <CroppedBitmap Source="/Resources/logo_installer.png" SourceRect="30,25,242,414"/>
            </Image.Source>
        </Image>

        <Path x:Name="HeadingPath" Fill="White"/>

        <TextBlock x:Name="SubtitleText" Canvas.Left="82" Canvas.Top="60" FontSize="12"
                   Foreground="{StaticResource Muted}"/>

        <Rectangle x:Name="Rule" Canvas.Left="24" Canvas.Top="96" Width="1002" Height="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DF3E60" Offset="0"/>
                    <GradientStop Color="#40DF3E60" Offset="0.55"/>
                    <GradientStop Color="#00DF3E60" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Canvas>
</UserControl>
