<UserControl x:Class="NMSRetroInstaller.IntroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMSRetroInstaller">
    <Grid>
        <Canvas Width="1050" Height="520">

            <!-- ============ the logo, animated as one group so it can shrink away ============ -->
            <Canvas x:Name="Logo" Width="1050" Height="450">

                <!-- Diamond without the arrow: the base that fades in first. -->
                <Image x:Name="LogoBase" Width="1050" Height="450" Opacity="0"
                       Source="/Resources/logo_installer_noarrow.png">
                    <Image.Clip><RectangleGeometry Rect="0,0,311,450"/></Image.Clip>
                </Image>

                <!-- Same diamond with the arrow, revealed through the sweeping wedge. Outside the
                     arrow the two images are identical, so the mask edge is only ever visible
                     where it crosses the arrow itself. -->
                <Image x:Name="LogoArrow" Width="1050" Height="450"
                       Source="/Resources/logo_installer.png">
                    <Image.Clip><RectangleGeometry Rect="0,0,311,450"/></Image.Clip>
                    <Image.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=MaskHost}" Stretch="Fill"/>
                    </Image.OpacityMask>
                </Image>

                <Canvas x:Name="TextLayer">
                    <Canvas.Effect>
                        <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3"
                                          BlurRadius="7" Opacity="0.8"/>
                    </Canvas.Effect>
                </Canvas>
            </Canvas>

            <!-- ============ steam login ============ -->

            <Canvas x:Name="SteamGroup" Opacity="0">
                <Rectangle Canvas.Left="553" Canvas.Top="13" Width="473" Height="288"
                           Fill="{StaticResource Well}" Stroke="{StaticResource Edge}"
                           StrokeThickness="2"/>

                <Image x:Name="SteamOrb" Canvas.Left="567" Canvas.Top="32" Width="70" Height="70"
                       Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Image.Source>
                        <CroppedBitmap Source="/Resources/steam_logo.png" SourceRect="38,222,664,664"/>
                    </Image.Source>
                </Image>

                <Image x:Name="SteamWord" Canvas.Left="646" Canvas.Top="52"
                       Width="121" Height="25" Opacity="0">
                    <Image.Source>
                        <CroppedBitmap Source="/Resources/steam_logo.png" SourceRect="783,420,1138,237"/>
                    </Image.Source>
                </Image>

                <TextBlock x:Name="SteamBlurb" Canvas.Left="567" Canvas.Top="114" Width="445"
                           Opacity="0" FontSize="14" LineHeight="18" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}"/>

                <Canvas x:Name="UserField" Opacity="0">
                    <TextBlock Canvas.Left="567" Canvas.Top="148" Text="STEAM USERNAME"
                               FontSize="14" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Canvas.Left="567" Canvas.Top="164"
                             Style="{StaticResource Field}"/>
                </Canvas>

                <Canvas x:Name="PassField" Opacity="0">
                    <TextBlock Canvas.Left="567" Canvas.Top="202" Text="STEAM PASSWORD"
                               FontSize="14" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Canvas.Left="567" Canvas.Top="218"
                                 PasswordChar="*" Style="{StaticResource Field}"/>
                </Canvas>

                <local:AccentButton x:Name="LoginButton" Text="LOGIN" Click="OnLogin"
                                    Canvas.Left="669.5" Canvas.Top="254" Width="240"
                                    Opacity="0" RenderTransformOrigin="0.5,0.5"/>
            </Canvas>

            <!-- ============ disclaimer ============ -->

            <Canvas x:Name="DisclaimerGroup" Opacity="0">
                <Path x:Name="DisclaimerHeading" Fill="White"/>
                <Rectangle Canvas.Left="20" Canvas.Top="310" Width="1006" Height="157"
                           Fill="{StaticResource Well}" Stroke="{StaticResource Edge}"
                           StrokeThickness="2"/>
                <ScrollViewer x:Name="DisclaimerScroll" Canvas.Left="34" Canvas.Top="322"
                              Width="978" Height="133" Opacity="0" Background="Transparent"
                              VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                    </ScrollViewer.Resources>
                    <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="15"
                               LineHeight="19" Foreground="{StaticResource Accent}"/>
                </ScrollViewer>
            </Canvas>

            <TextBlock x:Name="Footnote" Canvas.Top="488" Width="1050" Opacity="0" FontSize="12"
                       TextAlignment="Center" Foreground="{StaticResource Muted}"><Run
                       Text="This unofficial installer is not affiliated with Hello Games or Steam, learn more at "/><Hyperlink
                       Style="{StaticResource AccentLink}" Click="OnWebsite">nomansskyretro.com</Hyperlink></TextBlock>

        </Canvas>

        <!-- Off-screen source for the arrow's opacity mask. The zero-sized canvas keeps it out of
             sight while still laying it out, which is what a VisualBrush needs. -->
        <Canvas Width="0" Height="0" ClipToBounds="True"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="MaskHost" Width="1050" Height="450"
                  Background="Transparent" ClipToBounds="True">
                <local:Wedge x:Name="ArrowWedge" Fill="White" Stretch="None"
                             Center="152,192" Radius="330" StartAngle="260" Sweep="0">
                    <local:Wedge.Effect><BlurEffect Radius="9"/></local:Wedge.Effect>
                </local:Wedge>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
