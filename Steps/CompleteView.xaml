<UserControl x:Class="NMSRetroInstaller.CompleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMSRetroInstaller">
    <Canvas Width="1050" Height="520">
        <local:StepHeader x:Name="Header" Heading="COMPLETE"
                          Subtitle="Your retro versions are installed. Pick one to play, or use the No Man's Sky Retro Launcher shortcut on your desktop."/>
        <local:LaunchPad x:Name="Pad" Canvas.Left="0" Canvas.Top="114" Width="1050" Height="386"/>
    </Canvas>
</UserControl>
