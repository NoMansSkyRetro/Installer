<UserControl x:Class="NMSRetroInstaller.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMSRetroInstaller">
    <Canvas Width="1050" Height="520">

        <local:StepHeader x:Name="Header" Heading="INSTALLING"
                          Subtitle="Downloading from Steam, patching with steam_api64.retro, applying the retro shader fix and writing shortcuts."/>

        <Canvas x:Name="ProgressRow" Opacity="0">
            <TextBlock x:Name="TaskText" Canvas.Left="24" Canvas.Top="116" FontSize="14"
                       Foreground="{StaticResource Label}"/>
            <TextBlock x:Name="PercentText" Canvas.Left="906" Canvas.Top="116" Width="120"
                       FontSize="14" TextAlignment="Right" Foreground="{StaticResource Accent}"/>
            <ProgressBar x:Name="Bar" Canvas.Left="24" Canvas.Top="140" Width="1002"
                         Style="{StaticResource AccentBar}"/>
        </Canvas>

        <Canvas x:Name="LogRow" Opacity="0">
            <TextBlock Canvas.Left="24" Canvas.Top="180" Text="INSTALL LOG"
                       Style="{StaticResource FieldLabel}"/>
            <Border Canvas.Left="24" Canvas.Top="196" Width="1002" Height="296"
                    Style="{StaticResource Terminal}">
                <Border BorderThickness="0,0,2,2" BorderBrush="{StaticResource BtnLight}">
                    <ScrollViewer x:Name="LogScroll" Margin="14,10" Padding="0,0,10,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                        </ScrollViewer.Resources>
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12.5"
                                   LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"/>
                    </ScrollViewer>
                </Border>
            </Border>
        </Canvas>

    </Canvas>
</UserControl>
